{
  "description": "GPT2-scale LinkSpace model with grouped subspaces. KV space has 2 groups of 128-dim, In/Gate space has 2 groups of 192-dim",
  "shorthand": "27l - 4h - kv128x2.ingt192x2 - mlp672",

  "model": {
    "vocab_size": 50257,

    "hidden_size": 768,

    "num_hidden_layers": 27,
    "interleave_dense": "dsssdsssdsssdsssdsssdsssdsd",
    "num_dense_layers": 0,

    "intermediate_size": 672,
    "num_attention_heads": 4,
    
    "spaces": {
      "d": {
        "size": -1,
        "num_groups": 1,
        "modules": ["Q", "O", "out"]
      },
      "kv": {
        "size": 128,
        "num_groups": 2,
        "modules": ["K", "V"]
      },
      "ingt": {
        "size": 192,
        "num_groups": 2,
        "modules": ["in", "gate"]
      }
    },

    "rope_dims": 32,
    "qk_private_dim": 64,
    "vo_private_dim": 64,
    "nope_dims": 32,
    
    "attention_backend": "flash_attention_2",
    "rope_theta": 10000.0,
    "rope_scaling": {
      "factor": 2.0,
      "type": "linear"
    },
    
    "attention_bias": false,
    

    "hidden_dropout_prob": 0.1,
    "attention_dropout_prob": 0.1,
    
    "max_position_embeddings": 1024,
    
    "initializer_range": 0.02,
    
    "rms_norm_eps": 1e-6,
    
    "classifier_dropout": null,
    
    "vocab_subspace": false,
    "vocab_rank": null,
    "tie_word_embeddings": true
  },
  "pre_train": {
    "wandb_project":        "linkdecoder-pretrain-wiki",
    "output_dir":           "checkpoints/link_27l_4h_kv128.ingt192_mlp672_wiki",
    "seed":                 42,
    "logging_steps":        50,
    "save_steps":           300,
    "train_batch_size":     8,
    "gradient_accumulation_steps": 64,
    "learning_rate":        5e-04,
    "num_train_steps":      3300,
    "eval_steps":           300,
    "weight_decay":         0.01,
    "num_workers":          8,
    "pin_memory":           true,
  
    "dataset_name":         "wikitext",
    "dataset_config":       "wikitext-103-raw-v1",
    "dataset_subset_pct":   null,
    
    "max_seq_length":       1024,
    "eval_batch_size":      8,
    
    "fp16":                 false,
    "bf16":                 true,
    "torch_compile":        true,
    "torch_compile_backend": "inductor",
    "torch_compile_mode":   "default"
  }
}