
{
  "shorthand": "t4_test.q_decomp_only",
  "notes": "Test configuration for T4 GPU with query decomposition only.",

  "model": {
    "hidden_size":          768,
    "num_hidden_layers":    12,
    "intermediate_size":    2048,

    "vocab_size":               50257,
    "tie_word_embeddings":      true,
    "max_position_embeddings":  128,

    "norm_type":            "rmsnorm",
    "layer_norm_eps":       1e-12,
    "rms_norm_eps":         1e-6,

    "num_dense_layers":     0,

    "num_attention_heads":  12,

    "q_shared_dim":         192,
    "kv_shared_dim":        null,
    "o_shared_dim":         null,

    "qk_private_dim":       64,
    "vo_private_dim":       64,

    "rope_dims":            32,
    "nope_dims":            32,

    "rope_theta":           10000.0,
    "rope_scaling":         null,

    "attention_bias":       false,

    "attention_backend":    "flash_attention_2",

    "ffn_decompose":     true,
    "ffn_rank":          192,

    "vocab_subspace":    false,
    "vocab_rank":        null,

    "hidden_dropout_prob":     0.1,
    "attention_dropout_prob":  0.1,
    "classifier_dropout":      null,
    "initializer_range":       0.02,

    "use_sparse_moe":      true,
    "num_experts":         4,
    "router_top_k":        2,
    "capacity_factor":     1.25,
    "router_noise_std":    1.0,
    "expert_dropout_prob": 0.1
  },

  "pre_train": {
    "wandb_project":        "decoder-pretrain-wiki-test",
    "output_dir":           "checkpoints/t4_test",
    "seed":                 42,
    "logging_steps":        10,
    "save_steps":           50,

    "train_batch_size":     4,
    "gradient_accumulation_steps": 4,
    "learning_rate":        5e-04,
    "num_train_steps":      100,
    "eval_steps":           50,
    "weight_decay":         0.01,
    "num_workers":          2,
    "pin_memory":           true,

    "dataset_name":         "yujiepan/wikitext-tiny",
    "dataset_config":       "default",
    "dataset_subset_pct":   null,

    "max_seq_length":       128,
    "eval_batch_size":      4,

    "fp16":                 false,
    "bf16":                 true,
    "torch_compile":        true,
    "torch_compile_backend": "inductor",
    "torch_compile_mode":   "default"
  }
}
